{
  "schemaVersion": 1,
  "id": "chestshare-plus",
  "version": "${version}",
  "name": "ChestShare+",
  "description": "Per-player instanced loot for world-generated containers. Server-side only. A fork of Calamech's ChestShare with modded-container support, async import, and bugfixes.",
  "authors": [
    "Calamech (original ChestShare)",
    "PsycloneTM (ChestShare+ fork)"
  ],
  "license": "MIT",
  "icon": "assets/chestshare/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.chestshare.ChestShare"
    ]
  },
  "mixins": [
    "chestshare.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": "~1.21.1",
    "java": ">=21"
  }
}
